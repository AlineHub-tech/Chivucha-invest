const getCookie = (name) => {
  if (typeof document === 'undefined') return '';
  const match = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
  return match ? decodeURIComponent(match[1]) : '';
};

const resolveToken = () => {
  const cookieToken = getCookie('chivucha_jwt_token') || getCookie('chivucha_token');
  if (cookieToken) return cookieToken;
  if (typeof window === 'undefined') return '';
  return localStorage.getItem('chivucha_jwt_token') || '';
};

export const readSession = () => {
  const token = resolveToken();
  if (!token) return null;

  try {
    const payload = token.split('.')[1];
    if (!payload) return null;
    const decoded = JSON.parse(atob(payload.replace(/-/g, '+').replace(/_/g, '/')));
    return {
      token,
      username: decoded.username || getCookie('chivucha_user') || localStorage.getItem('chivucha_logged_user') || 'Guest',
      role: decoded.role || getCookie('chivucha_role') || localStorage.getItem('chivucha_user_role') || 'GUEST'
    };
  } catch (error) {
    return null;
  }
};

